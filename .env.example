# EV Charging Orchestration Platform — Environment Variables
# Copy this file to .env (not committed) and fill in real values.
# For ASP.NET Core, these map to appsettings.json keys using __ as separator.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# ConnectionStrings__DefaultConnection format:
#   Host=<host>;Port=5432;Database=<dbname>;Username=<user>;Password=<password>;sslmode=disable
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=hackathon_ev_charging;Username=postgres;Password=REPLACE_ME;sslmode=disable

# ── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
Jwt__Secret=REPLACE_WITH_SECURE_RANDOM_SECRET_MINIMUM_32_CHARS
Jwt__Issuer=hackathon-api
Jwt__Audience=hackathon-client
Jwt__ExpiryHours=24

# ── CSMS Integration ────────────────────────────────────────────────────────
# Provided NexLevel CSMS REST API base URL
Csms__BaseUrl=http://localhost:3000

# Optional auth header value (e.g. "Bearer <token>" or "Basic <base64>")
# Leave empty if the CSMS API requires no authentication
Csms__AuthHeader=

# Set to "true" to bypass live CSMS calls and return fixture data (demo fallback)
Csms__MockMode=false

# ── Email Notifications (P1, optional) ─────────────────────────────────────
# MailKit SMTP settings — leave empty to use payload-preview-only mode
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=noreply@nexlevel.mu

# ── Microsoft Teams Notifications (P1, optional) ───────────────────────────
# Incoming webhook URL — leave empty to use payload-preview-only mode
Teams__WebhookUrl=

# ── AI Insights (P2, optional) ─────────────────────────────────────────────
# Azure OpenAI settings — leave empty to disable live AI calls
AzureOpenAI__Endpoint=
AzureOpenAI__ApiKey=
AzureOpenAI__DeploymentName=gpt-4o
